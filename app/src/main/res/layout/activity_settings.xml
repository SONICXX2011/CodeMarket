<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="?android:attr/textColorPrimary"
        android:background="?attr/selectableItemBackgroundBorderless" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="شخصی‌سازی برنامه"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تم برنامه"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/rgTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1A888888"
        android:padding="8dp">

        <RadioButton
            android:id="@+id/rbLight"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="روشن"
            android:textColor="?android:attr/textColorPrimary"
            android:buttonTint="#5288C1" />

        <RadioButton
            android:id="@+id/rbDark"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="تاریک"
            android:textColor="?android:attr/textColorPrimary"
            android:buttonTint="#5288C1" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اندازه متن پست‌ها"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="12dp" />

    <SeekBar
        android:id="@+id/seekBarTextSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="14"
        android:progress="0"
        android:progressTint="#5288C1"
        android:thumbTint="#5288C1" />

    <TextView
        android:id="@+id/tvTextSizePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="نمونه اندازه متن"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginTop="16dp"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/layoutVipSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تنظیمات ویژه (VIP)"
            android:textColor="#FFD600"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رنگ پس‌زمینه پیام‌های شما (مثال: #33FF0000)"
            app:hintTextColor="#FFD600"
            app:boxStrokeColor="#FFD600"
            app:boxBackgroundColor="#1A888888">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="48dp"
        android:text="ذخیره تنظیمات"
        app:cornerRadius="16dp"
        app:backgroundTint="#5288C1" />

</LinearLayout>