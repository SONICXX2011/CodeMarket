<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMessageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMessageBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="320dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- بخش نقل قول (ریپلای خط دار) -->
            <LinearLayout
                android:id="@+id/layoutReplyQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1AA1887F"
                android:visibility="gone"
                android:layout_marginBottom="8dp">
                
                <View 
                    android:layout_width="3dp" 
                    android:layout_height="match_parent" 
                    android:background="#A1887F" />
                
                <LinearLayout 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:orientation="vertical" 
                    android:paddingHorizontal="8dp" 
                    android:paddingVertical="4dp">
                    
                    <TextView 
                        android:id="@+id/tvReplyUsernameQuote" 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:textColor="#A1887F" 
                        android:textStyle="bold" 
                        android:textSize="12sp" />
                        
                    <TextView 
                        android:id="@+id/tvReplyTextQuote" 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:textColor="?android:attr/textColorSecondary" 
                        android:textSize="11sp" 
                        android:maxLines="1" 
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- بخش مدیا (ویدیو و عکس) -->
            <FrameLayout
                android:id="@+id/layoutMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="8dp">
                
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    
                    <ImageView 
                        android:id="@+id/imgMessageMedia" 
                        android:layout_width="240dp" 
                        android:layout_height="240dp" 
                        android:scaleType="centerCrop" 
                        android:background="#1A000000" />
                        
                    <!-- هاله تیره روی ویدیوها -->
                    <View
                        android:id="@+id/viewMediaOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#4D000000"
                        android:visibility="gone"/>
                </androidx.cardview.widget.CardView>

                <ImageView 
                    android:id="@+id/imgPlayVideo" 
                    android:layout_width="56dp" 
                    android:layout_height="56dp" 
                    android:layout_gravity="center" 
                    android:background="@drawable/bg_circle_glass"
                    android:backgroundTint="#80000000"
                    android:padding="16dp"
                    android:src="@drawable/ic_play_circle" 
                    app:tint="@android:color/white" 
                    android:visibility="gone"/>

                <TextView 
                    android:id="@+id/tvMediaInfo" 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:layout_gravity="top|start" 
                    android:layout_margin="8dp" 
                    android:background="@drawable/bg_circle_glass" 
                    android:backgroundTint="#80000000" 
                    android:textColor="@android:color/white" 
                    android:textSize="11sp" 
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp" 
                    android:paddingVertical="4dp" 
                    android:visibility="gone"/>
            </FrameLayout>

            <!-- پلیر ویس تلگرامی -->
            <LinearLayout
                android:id="@+id/layoutVoice"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                android:padding="8dp"
                android:background="@drawable/bg_glass_input">
                
                <ImageView
                    android:id="@+id/btnPlayVoice"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_play_circle"
                    app:tint="#A1887F"
                    android:background="?attr/selectableItemBackgroundBorderless" />
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    
                    <SeekBar
                        android:id="@+id/seekBarVoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:progressTint="#A1887F"
                        android:thumbTint="#A1887F"/>
                        
                    <TextView
                        android:id="@+id/tvVoiceInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00 • در حال بارگیری..."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- داکیومنت و فایل متفرقه -->
            <LinearLayout
                android:id="@+id/layoutFile"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                android:padding="12dp"
                android:background="@drawable/bg_glass_input">
                
                <ImageView
                    android:id="@+id/btnDownloadFile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_file"
                    app:tint="@android:color/white"
                    android:background="@drawable/bg_circle_glass"
                    android:backgroundTint="#A1887F"
                    android:padding="12dp" />
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    
                    <TextView
                        android:id="@+id/tvFileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="فایل"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="middle"/>
                        
                    <TextView
                        android:id="@+id/tvFileSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="برای دانلود کلیک کنید"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <!-- بخش زمان پیام و تیک خوانده شدن (تلگرامی) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                
                <TextView 
                    android:id="@+id/tvMessageTime" 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:textColor="#888888" 
                    android:textStyle="bold"
                    android:textSize="10sp" />
                
                <ImageView 
                    android:id="@+id/imgMessageStatus" 
                    android:layout_width="16dp" 
                    android:layout_height="16dp" 
                    android:layout_marginStart="4dp" 
                    android:src="@drawable/ic_check" 
                    app:tint="#A1887F" 
                    android:visibility="gone"/>
            </LinearLayout>
            
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>