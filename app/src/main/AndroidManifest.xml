<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- دسترسی‌های اینترنت و شبکه (برای ارتباط با سرور و دانلود/آپلود) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- دسترسی‌های خواندن و نوشتن فایل در اندروید 12 و پایین‌تر -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    
    <!-- دسترسی‌های مخصوص اندروید 13 و بالاتر برای رسانه‌ها (عکس، ویدیو، ویس) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodeMarket"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="31">

        <!-- اکتیویتی خانه (لانچر اصلی برنامه) -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- اکتیویتی چت تلگرامی (با تنظیم کیبورد برای بالا اومدن نوار چت) -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- اکتیویتی جزئیات پست و کامنت‌ها -->
        <activity
            android:name=".PostDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- اکتیویتی جزئیات سورس در فروشگاه -->
        <activity
            android:name=".SourceDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- اکتیویتی ارسال پست جدید -->
        <activity
            android:name=".CreatePostActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- اکتیویتی پروفایل کاربران -->
        <activity
            android:name=".UserProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- اکتیویتی تنظیمات و شخصی‌سازی VIP -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

    </application>

</manifest>